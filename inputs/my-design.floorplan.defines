# Floorplan definition - for create_floorplan command
set design(floorplan_ratio) 0.9  ; # Aspect ratio of the floorplan
set design(floorplan_utilization) 0.5   ; # Target utilization of the floorplan
set design(floorplan_space_to_core) "10 10 10 10" ; # Spacing between the macro/IO edge to the core
        # Note that this should be passed as four arguments and not a list,
		# Therefore, use the expand list {*} operator!

# Rings around the fullchip/macro core - for add_rings command
set design(core_ring_nets) "$design(digital_gnd) $design(digital_vdd)"
set M2_db [lindex [get_db layers] 1]
set M3_db [lindex [get_db layers] 2]
set design(core_ring_width) [expr 100*[get_db $M3_db .min_width]];
set design(core_ring_spacing) [expr 20*[get_db $M3_db .min_spacing]];
set design(core_ring_layers) "bottom [get_db $M3_db .name] top [get_db $M3_db .name] right [get_db $M2_db .name] left [get_db $M2_db .name]"

# Power grid definition - to be used with add_stripes command
set design(M2_stripes_width) [expr 10*[get_db $M2_db .min_width]]
set design(M2_stripes_spacing) [expr 2*[get_db $M2_db .min_spacing]];
set design(M2_stripes_interval) [expr 200*[get_db $M2_db .min_spacing]];
set design(M2_stripes_from_left) [expr 50*[get_db $M2_db .min_spacing]];
set design(M2_stripe_nets) "$design(digital_gnd) $design(digital_vdd)"

# Special procedure to ensure no standard cells are placed underneath M2 stripes
proc enics_add_m2_stripe_blockage {} {
    global design
    # Add M2 routing blockages arround vertical power stripes to prevent M2 routing DRCs near them:
    deselect_obj -all
    set m1_name [get_db [lindex [get_db layers] 0] .name]
    set m2_name [get_db [lindex [get_db layers] 1] .name]
    select_routes -shapes stripe -layer $m2_name -nets $design(M2_stripe_nets)
    foreach stripe [get_db selected] {
        create_route_blockage -name M2_pwr_stripe_route_blk \
	    -layers "$m1_name $m2_name" \
	    -spacing [expr 2*[get_db [lindex [get_db layers] 1] .min_spacing]] \
	    -area [get_db $stripe .rect]
    }
    deselect_routes
}

# Procedure to remove the blockage to enable fillers to be placed.
proc enics_delete_m2_stripe_blockage {} {
    deselect_obj -all
    select_obj [get_db route_blockages -if {.name == M2_pwr_stripe_route_blk}]  
    delete_selected_from_floorplan
}
